# ─────────────────────────────────────────────────────────────
# THE US ARCHIVE — environment configuration
# Copy to .env and adjust. Everything has a safe default; the demo
# runs with NO changes (offline mock AI provider).
# ─────────────────────────────────────────────────────────────

# --- AI provider ---------------------------------------------------
# "mock" (default, offline, no key needed) or "anthropic".
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Cheap model for bulk chunk work; expensive model for final synthesis.
ANALYSIS_MODEL=claude-haiku-4-5-20251001
SYNTHESIS_MODEL=claude-opus-4-8
AI_MAX_RETRIES=3
AI_CHUNK_SIZE=400

# --- Privacy -------------------------------------------------------
# Raw conversations are auto-deleted this many days after delivery.
RAW_DATA_RETENTION_DAYS=7
# SAFE strips sensitive/explicit content from the deliverable. NORMAL keeps more.
CONTENT_SENSITIVITY=SAFE
# Minimum confidence [0..1] to keep an LLM-inferred inside joke / milestone.
INSIDE_JOKE_CONFIDENCE=0.6
MILESTONE_CONFIDENCE=0.6

# --- Analysis tuning ----------------------------------------------
# Gap (hours) that separates one conversation "session" from the next.
SESSION_GAP_HOURS=6

# --- Branding ------------------------------------------------------
BRAND_NAME=The Us Archive
BRAND_WATERMARK=true
BRAND_WATERMARK_TEXT=Made with The Us Archive

# --- Web app / infra (roadmap — see README) -----------------------
# DATABASE_URL=postgresql://user:pass@localhost:5432/us_archive
# STORAGE_PROVIDER=local            # local | s3 | supabase
# EMAIL_PROVIDER=console            # console | resend | smtp
# ORDER_PROVIDER=mock               # mock | etsy
