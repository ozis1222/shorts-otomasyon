# ─────────────────────────────────────────────────────────────
# THE US ARCHIVE — environment configuration
# Copy to .env and adjust. Everything has a safe default; the demo
# runs with NO changes (offline mock AI provider).
# ─────────────────────────────────────────────────────────────

# --- AI provider ---------------------------------------------------
# "mock" (default, offline, no key needed) or "anthropic".
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Cheap model for bulk chunk work; expensive model for final synthesis.
ANALYSIS_MODEL=claude-haiku-4-5-20251001
SYNTHESIS_MODEL=claude-opus-4-8
AI_MAX_RETRIES=3
AI_CHUNK_SIZE=400

# --- Privacy -------------------------------------------------------
# Raw conversations are auto-deleted this many days after delivery.
RAW_DATA_RETENTION_DAYS=7
# SAFE strips sensitive/explicit content from the deliverable. NORMAL keeps more.
CONTENT_SENSITIVITY=SAFE
# Minimum confidence [0..1] to keep an LLM-inferred inside joke / milestone.
INSIDE_JOKE_CONFIDENCE=0.6
MILESTONE_CONFIDENCE=0.6

# --- Analysis tuning ----------------------------------------------
# Gap (hours) that separates one conversation "session" from the next.
SESSION_GAP_HOURS=6

# --- Branding ------------------------------------------------------
BRAND_NAME=The Us Archive
BRAND_WATERMARK=true
BRAND_WATERMARK_TEXT=Made with The Us Archive

# --- Web app -------------------------------------------------------
# Public base URL of the deployed app (used in customer email links).
APP_BASE_URL=http://localhost:3000
# Where the SQLite DB, uploads and generated archives live.
DATA_DIR=./data
# Secret for signing admin sessions, download URLs and the cron endpoint.
# CHANGE THIS in production (a long random string).
APP_SECRET=dev-insecure-secret-change-me
# Password for the /admin seller dashboard.
ADMIN_PASSWORD=admin

# --- Orders / email ------------------------------------------------
ORDER_PROVIDER=mock                 # mock | etsy
EMAIL_PROVIDER=console              # console | resend
RESEND_API_KEY=
EMAIL_FROM=The Us Archive <hello@yourdomain.com>

# --- Etsy (fill these to go live — see README "Go live") -----------
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=
ETSY_REDIRECT_URI=http://localhost:3000/api/etsy/callback
# Map each Etsy listing id to a package tier, e.g.
# ETSY_LISTING_MAP={"1234567890":"full","1234567891":"vault","1234567892":"mini"}
ETSY_LISTING_MAP={}
