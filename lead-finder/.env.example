# ============================================================
#  Lead Finder - Ortam Degiskenleri
#  Bu dosyayi ".env" olarak kopyalayin ve gerekirse duzenleyin.
#  Hicbirini doldurmasaniz bile sistem calisir (makul varsayimlar kullanilir).
# ============================================================

# --- Veritabani ---
# SQLite kullanir (kurulum gerektirmez). Dosya otomatik olusturulur.
DATABASE_URL=sqlite:///./lead_finder.db

# --- Uygulama ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Veri Toplama (OpenStreetMap / Overpass) ---
# Overpass API sunucusu (ucretsiz, acik kaynak).
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Nominatim (adres -> koordinat) sunucusu.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Kaynaklara asiri yuk bindirmemek icin istekler arasi bekleme (saniye).
REQUEST_DELAY_SECONDS=1.0
# Nominatim/Overpass icin User-Agent.
# ONEMLI: OSM servisleri placeholder/ornek (ornek: example@example.com) User-Agent'lari
# ENGELLER (403/406). Benzersiz, gercek bir tanimlayici kullanin. Bir URL yeterlidir;
# isterseniz kendi e-postanizi yazin.
USER_AGENT=LeadFinder/1.0 (+https://github.com/ozis1222/shorts-otomasyon)

# --- Web Sitesi Analizi ---
# Bir siteyi kontrol ederken en fazla beklenecek sure (saniye).
WEBSITE_TIMEOUT_SECONDS=12
# Bu sureden yavas siteler "yavas" sayilir (saniye).
SLOW_THRESHOLD_SECONDS=3.0

# --- Yapay Zeka (OPSIYONEL) ---
# none   = AI kapali (varsayilan, tamamen ucretsiz, kurulum gerektirmez)
# ollama = Yerel Ollama modeli (ucretsiz, once "ollama" kurmalisiniz)
# claude = Anthropic Claude API (UCRETLI, API anahtari gerekir)
AI_MODE=none

# Ollama ayarlari (AI_MODE=ollama ise)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Claude ayarlari (AI_MODE=claude ise) - UCRETLI
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
