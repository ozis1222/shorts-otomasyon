# Linux (GitHub Actions) uzerinde calisan dosyalar HER ZAMAN LF olmali.
# Windows'ta duzenlenip CRLF olurlarsa bash "\r: command not found" hatasi verir.
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Ikili dosyalar donusturulmesin
*.png   binary
*.jpg   binary
*.ttf   binary
*.mp4   binary
*.mp3   binary
